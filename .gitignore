# Secrets and machine-specific environment configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Node.js, Vite, TypeScript, test and coverage output
node_modules/
apps/web/dist/
coverage/
*.tsbuildinfo
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Laravel and PHP dependencies, caches and runtime files
apps/api/vendor/
apps/api/bootstrap/cache/*
!apps/api/bootstrap/cache/.gitignore
apps/api/storage/logs/*
!apps/api/storage/logs/.gitignore
apps/api/storage/framework/cache/data/*
!apps/api/storage/framework/cache/data/.gitignore
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitignore
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitignore
apps/api/public/storage
apps/api/.phpunit.result.cache
phpunit.result.cache

# Docker local overrides and database dumps
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
*.sql
!apps/api/database/*.sql
*.sqlite
*.sqlite3

# Editor and operating-system noise
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
